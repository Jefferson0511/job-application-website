# Copy to .env and fill in. `docker compose up` sets all of these for you.

# Postgres connection string. The database must have the pgvector extension
# available, or semantic search will report itself unavailable at boot.
# The pgvector/pgvector image ships it; the stock postgres image does not.
DATABASE_URL=postgres://jobs:jobs@localhost:5432/jobs

# Secret used to sign JWTs. Required: the app refuses to start without it, so
# that no hardcoded development default can reach production.
# Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=

# Port the API listens on. The frontend defaults to 3002 in development.
PORT=3002

# Extra browser origins allowed through CORS, comma separated.
# localhost:3000 and the Vercel deployment are always allowed.
CORS_ORIGINS=

# TypeORM schema auto-sync. Convenient in development; set to false in
# production, where it can silently drop columns.
DB_SYNCHRONIZE=true

# Log every SQL statement. Useful when debugging a query, noisy otherwise.
DB_LOGGING=false

# Where the embedding model is cached. The Docker image bakes the model in and
# points this at it; leave unset locally to use the library default.
# TRANSFORMERS_CACHE_DIR=
